# Copie para .env e preencha. Nunca versione o .env.
# Este arquivo contém apenas nomes de variáveis, nenhum valor.

# --- Aplicação ---
APP_ENV=
APP_BASE_URL=
# Chave usada para assinar cookies de sessão (aleatória, longa)
SECRET_KEY=
# Em produção: true
SESSION_COOKIE_SECURE=true

# --- Banco de dados ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Criptografia dos tokens do Mercado Livre (nunca no banco, nunca no Git) ---
# Chave de 32 bytes em base64 (Fernet/AES-GCM)
TOKEN_ENCRYPTION_KEY=

# --- Mercado Livre (DevCenter) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser idêntica à cadastrada no aplicativo
ML_REDIRECT_URI=

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_DAILY_TOKEN_LIMIT=

# --- Parâmetros financeiros padrão ---
TAX_RATE=
MONTHLY_FIXED_COSTS=
TARGET_MARGIN=

# --- Agendamento ---
DAILY_RUN_TIME=06:00
TIMEZONE=America/Sao_Paulo

# --- Backup ---
BACKUP_RETENTION_DAYS=14
